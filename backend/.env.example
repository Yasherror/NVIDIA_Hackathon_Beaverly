# ============================================================
# Beaverly - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Nebius Token Factory ---
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# --- Model Selection ---
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B       # Fast: scope detection, classification
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b         # Smart: drafting, verification
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b         # Complex legal reasoning fallback
MODEL_HERMES=NousResearch/Hermes-4-405B                # Agent runtime & skills
MODEL_EMBED=Qwen/Qwen3-Embedding-8B                   # 4096-dim Embeddings for LanceDB RAG

# --- App Settings ---
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Storage ---
DB_PATH=./db/beaverly.db             # SQLite database
LANCEDB_PATH=./db/lancedb            # LanceDB vector store
UPLOADS_PATH=./uploads               # Uploaded case documents
SANDBOXES_PATH=./sandboxes           # Sandboxed matter directories

# --- Security ---
SECRET_KEY=dev-secret-change-in-production
