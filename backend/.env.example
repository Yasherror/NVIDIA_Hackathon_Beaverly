# ============================================================
# Beaverly - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Nebius Token Factory ---
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# --- Model Selection ---
MODEL_NANO=Qwen/Qwen3-30B-A3B        # Fast: scope detection, classification
MODEL_SUPER=nvidia/llama-3.1-nemotron-70b-instruct  # Smart: drafting, verification
MODEL_EMBED=BAAI/bge-en-icl           # Embeddings for RAG

# --- App Settings ---
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Storage ---
DB_PATH=./db/beaverly.db             # SQLite database
LANCEDB_PATH=./db/lancedb            # LanceDB vector store
UPLOADS_PATH=./uploads               # Uploaded case documents

# --- Security ---
SECRET_KEY=change_this_to_random_secret
